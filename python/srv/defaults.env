# AltaStor Backup & Replication - server default values.
#
# This file ships with the code and is replaced wholesale on every package
# upgrade. It is the single place developers write down what a server
# setting defaults to; it is not meant to be edited by a deployment.
#
# Resolution order at startup: an environment variable, if set, always wins
# over the value here (see /etc/altastor-backup/server.conf, which is what a
# deployment actually edits).
#
# Format: KEY=VALUE, one variable per line, comments allowed.
#
# MONGODB_URI is deliberately absent: an unset value has its own separate
# fail-fast behaviour and must not silently get a default here.

# --- Server bind address ---
ALTASTOR_BACKUP_HOST=0.0.0.0
# 443 is the port https:// implies, so the console is reachable as
# https://<appliance> with no port to remember or type -- which is also what
# makes the redirect listener below land somewhere clean. Being below 1024 it
# needs AmbientCapabilities=CAP_NET_BIND_SERVICE in the systemd unit; without
# that the server cannot bind and will not start.
# An existing installation is NOT moved by an upgrade: a port written into
# /etc/altastor-backup/server.conf overrides this file and keeps whatever it
# says. Changing it there is a deliberate step, and every CLI client then needs
# its BACKUP_SERVER_URL updated to match.
ALTASTOR_BACKUP_PORT=443

# --- Plain-HTTP redirect listener ---
# A second, plaintext listener that answers every request with a permanent
# redirect to https://<the host the client asked for>:ALTASTOR_BACKUP_PORT. It
# exists because the browser, not the user, picks the scheme when someone types
# a bare host name: that guess is http, it lands on a TLS port, the handshake
# fails and the browser shows an error with nothing to explain it. A single TCP
# port cannot serve both TLS and plaintext, so the redirect needs a port of its
# own -- this is exactly what a reverse proxy would have done for us, minus the
# reverse proxy.
# Port 80 is below 1024, so the unit needs AmbientCapabilities=CAP_NET_BIND_SERVICE
# -- the same capability that ALTASTOR_BACKUP_PORT=443 above already requires.
# Leave empty to switch the listener off -- which is what a host that already
# runs something else on port 80 should do. A port that cannot be bound is only
# ever a warning in the log: HTTPS comes up regardless.
ABR_HTTP_REDIRECT_PORT=80

# --- MongoDB (backup catalog) ---
MONGODB_DB_NAME=backup_db
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=10000

# --- Resource limits (tuned for a small, single-VM deployment) ---
# Total worker threads in the task pool.
BACKUP_WORKER_COUNT=4
# Max backup jobs allowed to run at once (others stay queued). Keep at 1 on a
# small host where MongoDB is co-located; raise only on larger hosts.
MAX_CONCURRENT_BACKUPS=1
# Bound the per-job RAM used to capture the data-mover's stdout/stderr (bytes).
BACKUP_TOOL_MAX_CAPTURE_BYTES=1048576
# Lower the mover's CPU/IO priority so a backup can't starve the API/MongoDB.
# Leave empty to disable. nice: -20..19 ; ionice class: 1=rt 2=best-effort 3=idle.
BACKUP_TOOL_NICE=10
BACKUP_TOOL_IONICE_CLASS=3
# How long a vCenter data-mover invocation may run before it's killed. This is
# a FLOOR: the effective per-disk timeout grows with the disk's capacity (see
# _disk_timeout_seconds), so a large VM is not killed mid-transfer.
BACKUPSERVER_VCENTER_TOOL_TIMEOUT_SECONDS=900
# How long a vCenter data mover may move no data before the backup gives up on
# the ESXi host's data path (a lost connection), stops the mover and fails.
BACKUPSERVER_DATA_PATH_STALL_SECONDS=180
# How far (hours) the server clock may move forward, while the server runs or
# between two of its runs, before retention stops deleting restore points until
# an Administrator confirms the time (abr system clock confirm). A clock that
# jumped ahead makes every restore point look older than it is.
BACKUPSERVER_CLOCK_JUMP_HOURS=24
# How often (seconds) the server retries lifting a relocation block (Storage
# vMotion/DRS) that a backup's data mover left on a VM and that could not be
# lifted when the backup ended, for example because vCenter was unreachable.
BACKUPSERVER_ACCESS_LOCK_RETRY_SECONDS=120
# How long (seconds) lifting that block waits for it to clear when it is still
# there right after being re-enabled. vCenter blocks the same method for its own
# tasks on the VM, such as removing the backup snapshot, and lifts that block a
# moment after the task reports completion.
BACKUPSERVER_ACCESS_LOCK_SETTLE_SECONDS=15
# How long (seconds) the server keeps retrying to consolidate a VM's disks when
# removing a backup snapshot left the VM needing it. A data mover that lost its
# connection mid-transfer can still hold the disks open on the host for a while.
BACKUPSERVER_CONSOLIDATION_SETTLE_SECONDS=60
# How long (seconds) a backup whose quiesce failed waits for the VM's event that
# says why (for example "Custom quiesce script failed"). vCenter only lists that
# event a few seconds after the snapshot task has failed; measured at 4-9 s.
BACKUPSERVER_QUIESCE_REASON_WAIT_SECONDS=15
# Throughput floor (MB/s) used to derive that per-disk timeout. Deliberately
# pessimistic -- far below what any real transport sustains -- so a healthy
# transfer of any size fits, while a hung tool is still reaped. Lower it if a
# genuinely slow link keeps tripping the timeout.
BACKUPSERVER_VCENTER_MIN_TRANSFER_MBPS=10
# How often (seconds) a running backup/restore pings its vCenter session while
# the data mover works. The mover uses its own VDDK connection, so without this
# the SOAP session sits idle for the whole transfer and vCenter closes it
# (config.vmacore.soap.sessionTimeout, 30 min by default) -- the calls after the
# transfer then fail with "The session is not authenticated". Must stay well
# under that server-side timeout.
BACKUPSERVER_VCENTER_SESSION_KEEPALIVE_SECONDS=300
# How long a single artifact verification may run, and how many run at once.
ALTASTOR_VERIFY_TIMEOUT_SECONDS=3600
ALTASTOR_VERIFY_CONCURRENCY=3
# How long to wait for a TCP connection to an S3 repository's configured
# endpoint before declaring it unreachable. This is only the reachability
# pre-check that `repo verify` and the pre-create connection test run before
# handing the endpoint to the data mover -- the mover retries its own 1s
# connect timeout several times per command, so without this an endpoint that
# black-holes the connect turns verify into a minutes-long hang instead of a
# failed check. An endpoint that is simply down refuses the connection and is
# reported at once; this budget is only ever spent in full on one that swallows
# the packet without answering. A TCP handshake is one round trip -- well under
# a second even intercontinentally -- so two seconds is roughly a sixfold
# margin; raise it only for a genuinely distant endpoint.
ALTASTOR_S3_CONNECT_TIMEOUT_SECONDS=2
# How long to wait for a TCP connection to a virtualization endpoint before
# declaring it unreachable. `inventory add` spends this once, to refuse an
# address that cannot be reached at the moment a typo is still cheap to fix,
# rather than letting the mistake surface at the first overnight backup. Only an
# endpoint that swallows the packet without answering spends the whole budget --
# one that is simply down refuses the connection immediately. Registration stays
# responsive because discovery itself still runs in the background afterwards.
ALTASTOR_INVENTORY_CONNECT_TIMEOUT_SECONDS=3
# How long the read/write/delete probe that proves S3 repository access may run.
# It round-trips a small backup through the bucket, so it is bounded by the
# storage's own responsiveness rather than by data size; a shared or distant
# object store under load can take far longer than an idle one. Raise it for a
# busy backend. Note that the data mover also gives up on its own when a
# transfer stalls, and that floor is inside the mover, not here -- raising this
# budget does not lift it.
ALTASTOR_S3_PROBE_TIMEOUT_SECONDS=600
# How long the S3 object-storage immutability checks may take. The first is a
# single `info` call that reads the bucket's Object Lock configuration, so it
# only ever waits on one round trip plus the mover's own connect retries. The
# second covers the write probe that proves immutability end to end: it stores a
# 512-byte test backup under Object Lock retention, reads the stored retention
# back, and then tries to delete it so the storage can refuse -- four mover
# invocations against the bucket, plus a sweep of test backups an earlier run
# left behind because their lock had not expired yet. Raise the probe budget for
# a distant or slow endpoint; a bucket that answers at all answers well inside it.
ALTASTOR_S3_IMMUTABILITY_INFO_TIMEOUT_SECONDS=60
ALTASTOR_S3_IMMUTABILITY_PROBE_TIMEOUT_SECONDS=300
# Stand-in, in days, for the distance to a job's next full backup when that date
# cannot be worked out. An Object Lock normally reaches the next full plus the
# job's retention, which is what makes every point of one chain expire together
# without the lock being rewritten as increments arrive. A job with no usable
# full-backup schedule, or a backup with no job behind it, has no such date, and
# this figure is used in its place. Ten days is the period the wider backup
# industry settled on for S3-compatible storage, where it is applied
# unconditionally rather than only as a fallback. It is only ever spent on
# backups whose cycle is unknown, so raising it lengthens those locks and
# lowering it risks freeing them while the chain still needs them.
ALTASTOR_S3_BLOCK_GENERATION_DAYS=10

# --- Authentication (REST API) ---
# On first boot (no users exist yet), the server auto-creates one admin user
# from ABR_BOOTSTRAP_ADMIN_USER and ABR_BOOTSTRAP_ADMIN_PASSWORD below. The
# shipped admin/admin is a known, weak default on purpose -- it does not meet
# the normal 8-character minimum, but is let through once for this bootstrap
# account specifically. Change it via `abr auth change-password` right after
# install; do not rely on it past initial setup.
ABR_BOOTSTRAP_ADMIN_USER=admin
ABR_BOOTSTRAP_ADMIN_PASSWORD=admin
# CLI and plain REST session lifetime, in seconds. Sliding: any authenticated
# request extends the session by this same amount.
ABR_SESSION_TTL_SECONDS=300
# Web UI: sign out after this much inactivity, seconds -- the default of the
# Settings -> Security slider, which may pick between MIN and MAX. A request the
# user caused extends the session; a background refresh (X-ABR-Refresh) does not.
ABR_WEB_SESSION_TTL_SECONDS=1800
ABR_WEB_SESSION_MIN_SECONDS=300
ABR_WEB_SESSION_MAX_SECONDS=7200
# Web UI: a session ends this long after sign-in whatever the activity, seconds;
# 0 = no limit.
ABR_WEB_SESSION_LIFETIME_SECONDS=7200
# Login brute-force lockout: after this many failed attempts for a given user
# name, further logins are rejected until the lockout window elapses.
ABR_LOGIN_MAX_ATTEMPTS=5
ABR_LOGIN_LOCKOUT_SECONDS=300

# --- HTTP security response headers ---
# Sent on every response, by the API and the web console alike -- they are one
# process behind one HTTPS listener, so there is no reverse proxy to configure
# these in. Setting any of them empty switches that single header off, which is
# how a deployment that genuinely needs to be framed relaxes the frame rules.
ABR_SECURITY_HEADER_FRAME_OPTIONS=DENY
ABR_SECURITY_HEADER_CONTENT_TYPE_OPTIONS=nosniff
# no-referrer rather than the usual strict-origin-when-cross-origin: the console
# loads web fonts from a third party, and console URLs carry job/VM identifiers
# that have no business appearing in anyone's referer log.
ABR_SECURITY_HEADER_REFERRER_POLICY=no-referrer
# API responses carry VM, job, repository and schedule names as JSON. Without
# this a browser is free to keep them in its on-disk cache on the operator's
# machine, including after they have logged out of the console. The network
# side is already covered by TLS and HSTS; this is about the client's disk.
ABR_SECURITY_HEADER_CACHE_CONTROL=no-store
# Deliberately limited to directives that govern who may embed or redirect the
# console, NOT which resources it may load. A content policy (default-src /
# script-src / style-src) additionally has to allow the Google Fonts stylesheet
# and font files the console pulls, and the blob: URL the support-bundle export
# downloads through -- tightening it further is safe only once it has been
# checked in a real browser, so it is left for a deployment to add here.
ABR_SECURITY_HEADER_CSP=frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
# Sent only over HTTPS: RFC 6797 requires browsers to ignore HSTS on a plain
# HTTP response, so emitting it there would only mislead a scanner. The real
# listener is HTTPS-only, so in production it is always sent.
ABR_SECURITY_HEADER_HSTS=max-age=31536000; includeSubDomains

# --- TLS (self-signed certificate bootstrap) ---
# Where the generated certificate/key (or an operator's own, installed from
# Settings > Security in the console or dropped in over them) live. Only the
# self-signed certificate the server generated itself is ever renewed or
# regenerated; an operator's is left alone. If this directory isn't writable --
# a dev checkout, not a real install -- the server falls back to python/tls/
# under the repo instead and logs that it did.
ABR_TLS_CERT_FILE=/etc/altastor-backup/tls/server.crt
ABR_TLS_KEY_FILE=/etc/altastor-backup/tls/server.key
# Key that encrypts the inventory credentials (vCenter, Hyper-V passwords and
# tokens) stored in the catalog database, so neither the database files nor
# MongoDB's slow-query log ever hold them in clear. Generated on first use with
# mode 0600 under the server's own data directory, which the package creates for
# the service and, like the catalog, keeps on purge: the key lives exactly as
# long as the database it decrypts. (Not next to the TLS key: purge deletes that
# directory, and a reinstall over the kept catalog could then decrypt nothing.)
# Losing it is not data loss -- each inventory's password then has to be entered
# again (abr inventory edit --password). A copy of the raw database files is only
# usable together with this file; `abr system export`/`import` does not need it.
ABR_CREDENTIAL_KEY_FILE=/var/lib/altastor-backup/credentials.key
# How many days a freshly generated self-signed certificate is valid for.
ABR_TLS_CERT_VALIDITY_DAYS=397
# How many days before expiry (or already past it) a certificate is renewed
# automatically the next time the server starts -- same key, new certificate.
ABR_TLS_RENEWAL_THRESHOLD_DAYS=30
# How often, in seconds, the running server re-checks the certificate for
# renewal (expiry or host IP drift) without needing a restart. The threshold
# above is in days, so hourly is more than granular enough.
ABR_TLS_RENEWAL_CHECK_INTERVAL_SECONDS=86400
# TLS 1.2 cipher suites, as an OpenSSL cipher string. Pinned rather than left
# to the platform: with no list of its own the server inherits whatever the
# installed uvicorn and OpenSSL happen to agree on, which is how a deployment
# ended up offering only CBC/HMAC-SHA1 on TLS 1.2 while a newer box on the same
# code offered AEAD. The list below is AEAD-only and forward-secret only -- no
# SHA-1 MAC, and no static-RSA suite that would drop forward secrecy.
# TLS 1.3 is NOT governed by this string; it carries its own AEAD-only suites.
# A string OpenSSL rejects, or one that matches nothing, is refused at startup
# and the shipped list below is used instead, so a typo here cannot quietly
# weaken the listener or stop the appliance from booting.
ABR_TLS_CIPHERS=ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256

# --- Inventory ---
# Best-effort VM discovery right after `inventory add`.
ABR_AUTO_DISCOVER_ON_ADD=1
# Allow registering the "mock" inventory type (dev/test only).
ABR_ENABLE_MOCK_INVENTORY=0

# --- Hyper-V ---
# Hyper-V disks are moved by abr-vhdx-tool (the abr-vhdx-tools repository) on
# the Hyper-V host itself. The appliance's copy of abr-vhdx-tool.exe, copied to
# every host that lacks it or has another build. Empty: tools/abr-vhdx-tool/x64/,
# where the altastor-backup-vhdx-tools package installs it, then
# tools/abr-vhdx-tool/, under the install root; with none there, each host must
# have the tool already.
ALTASTOR_VHDX_TOOL_PATH=
# Where the tool is installed on the Hyper-V hosts; used only when this
# appliance has no copy of it to upload.
ALTASTOR_HYPERV_TOOL_PATH=C:\Program Files\AltaStor\abr-vhdx-tool.exe
# Folder on the Hyper-V hosts that keeps this appliance's abr-vhdx-tool and
# PowerShell scripts, one subfolder per build named by their SHA-256. A build
# already there is reused; a missing or altered one is uploaded again.
ALTASTOR_HYPERV_WORK_DIR=C:\ProgramData\AltaStor\abr-hyperv
